{
  "annotations": {
    "list": [
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "expr": "fibre_block_reconstructed_event{node=~\".*\"} == 1",
        "iconColor": "#FFC000",
        "name": "Block Arrival",
        "titleFormat": "Block {{height}} — {{node}}",
        "step": "15s"
      }
    ]
  },
  "description": "Real-time monitoring of FIBRE block relay performance (public view)",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "options": {
        "content": "# FIBRE Block Relay Dashboard\nReal-time monitoring of UDP block relay performance.",
        "mode": "markdown"
      },
      "transparent": true,
      "type": "text"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "How many blocks were assembled from FIBRE/UDP FEC chunks in the selected time range. If this number is zero, blocks are arriving via compact blocks or full download instead of FIBRE.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 2 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "round(sum by (node) (increase(fibre_blocks_reconstructed_total{node=~\".*\"}[$__range])))", "legendFormat": "{{node}}" }
      ],
      "title": "Blocks Reconstructed",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "How many blocks this node relayed out to its FIBRE peers. Only relevant if the node acts as a relay sender.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 2 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "round(sum by (node) (increase(fibre_blocks_sent_total{node=~\".*\"}[$__range])))", "legendFormat": "{{node}}" }
      ],
      "title": "Blocks Sent",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "The latest block height seen by the node. A quick liveness check — if it stops increasing, the node may be stalled or disconnected.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "purple", "value": null }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 2 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "fibre_last_block_height{node=~\".*\"}", "legendFormat": "{{node}}" }
      ],
      "title": "Block Height",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Rolling reconstruction latency percentiles shown as discrete time-series points. Lower is better. Values under 100ms indicate a healthy FIBRE connection; sparse periods may show gaps because reconstruction is block-driven, not continuous.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 6,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "always",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 7 },
      "id": 12,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(fibre_block_reconstruction_duration_seconds_bucket{node=~\".*\"}[$__rate_interval])) by (le, node))", "legendFormat": "p50 - {{node}}" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(fibre_block_reconstruction_duration_seconds_bucket{node=~\".*\"}[$__rate_interval])) by (le, node))", "legendFormat": "p95 - {{node}}" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum(rate(fibre_block_reconstruction_duration_seconds_bucket{node=~\".*\"}[$__rate_interval])) by (le, node))", "legendFormat": "p99 - {{node}}" }
      ],
      "title": "Block Reconstruction Time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Per-block chunk averages over Grafana's adaptive query window. \"Avg used/block\" comes from the per-block histogram, while \"Avg received/block\" is total received chunks divided by reconstructed blocks in the same window. Gaps are expected when no blocks were reconstructed.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 6,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "always",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 13,
      "options": {
        "legend": { "calcs": ["mean", "last"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "rate(fibre_block_chunks_used_sum{node=~\".*\"}[$__rate_interval]) / rate(fibre_block_chunks_used_count{node=~\".*\"}[$__rate_interval])", "legendFormat": "Avg used/block - {{node}}" },
        { "refId": "B", "expr": "increase(fibre_chunks_received_total{node=~\".*\"}[$__rate_interval]) / increase(fibre_blocks_reconstructed_total{node=~\".*\"}[$__rate_interval])", "legendFormat": "Avg received/block - {{node}}" }
      ],
      "title": "Chunks per Block",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Chunk efficiency over Grafana's adaptive query window. Values near 1.0 mean most received chunks were needed; lower values mean more FEC overhead was consumed. Gaps are expected during windows with no reconstructed blocks.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 6,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "always",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] },
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 16,
      "options": {
        "legend": { "calcs": ["mean", "last"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "increase(fibre_chunks_used_total{node=~\".*\"}[$__rate_interval]) / increase(fibre_chunks_received_total{node=~\".*\"}[$__rate_interval])", "legendFormat": "Efficiency - {{node}}" }
      ],
      "title": "Chunk Efficiency (Used/Received)",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["fibre", "bitcoin", "block-relay", "public"],
  "templating": {
    "list": []
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "FIBRE Block Relay (Public)",
  "uid": "fibre-relay-public",
  "version": 1
}
