{
  "annotations": {
    "list": [
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "expr": "max by (height) (fibre_block_reconstructed_event == 1) unless max by (height) (fibre_block_reconstructed_event offset 15s == 1)",
        "iconColor": "rgba(204, 204, 220, 0.5)",
        "name": "Block Arrival",
        "titleFormat": "Block {{height}}",
        "step": "15s",
        "filter": { "exclude": true, "ids": [26] }
      }
    ]
  },
  "description": "Real-time monitoring of FIBRE block relay performance (public view)",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "options": {
        "content": "FIBRE relays new Bitcoin blocks between nodes over UDP with error correction, so a node can rebuild a block from whichever packets arrive. This page shows the monitored nodes and how quickly each one rebuilds blocks.",
        "mode": "markdown"
      },
      "transparent": true,
      "type": "text"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 2 },
      "id": 30,
      "panels": [],
      "title": "Network",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "How many monitored nodes the collector can reach. A node counts as down once its exporter has not answered for 30 seconds, so a restart that misses one scrape does not show.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Down" },
            "properties": [
              { "id": "color", "value": { "mode": "thresholds" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "text", "value": null }, { "color": "red", "value": 1 }] } }
            ]
          }
        ]
      },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 3 },
      "id": 20,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        { "refId": "A", "expr": "count(max_over_time(up{job=\"fibre\"}[30s]) == 1) or vector(0)", "legendFormat": "Up", "instant": true, "range": false },
        { "refId": "B", "expr": "count(max_over_time(up{job=\"fibre\"}[30s]) == 0) or vector(0)", "legendFormat": "Down", "instant": true, "range": false }
      ],
      "title": "Nodes",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "The highest block height any node has seen.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 3 },
      "id": 21,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        { "refId": "A", "expr": "max(fibre_last_block_height)", "instant": true, "range": false }
      ],
      "title": "Chain Tip",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "How long ago the chain tip last advanced on any node, by any delivery path. Blocks arrive about every 10 minutes on average, but an hour without one happens a few times a year. Looks back 6 hours.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "mappings": [],
          "noValue": "over 6 h",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }, { "color": "orange", "value": 3600 }, { "color": "red", "value": 7200 }] },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 3 },
      "id": 22,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        { "refId": "A", "expr": "time() - max_over_time((vector(time()) and on() (max(fibre_last_block_height) > max(fibre_last_block_height offset 30s)))[6h:15s])", "instant": true, "range": false }
      ],
      "title": "Time Since Last Block",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 31,
      "panels": [],
      "title": "Nodes",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "One row per monitored node. Status is whether the collector has reached the node's exporter in the last 30 seconds. Blocks behind is how far the node's last seen height trails the chain tip. Blocks reconstructed counts the blocks the node assembled from FIBRE/UDP chunks in the selected time range, and Mean reconstruction is the node's mean time to do so, from the first UDP packet to the decoded block. A node that is down shows no figures.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": false,
            "inspect": false
          },
          "mappings": [],
          "noValue": "–",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              { "id": "mappings", "value": [{ "type": "value", "options": { "0": { "color": "red", "index": 0, "text": "● Down" }, "1": { "color": "green", "index": 1, "text": "● Up" } } }] },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "custom.align", "value": "left" },
              { "id": "custom.width", "value": 110 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Blocks behind" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "color", "value": { "mode": "thresholds" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "text", "value": null }, { "color": "orange", "value": 2 }, { "color": "red", "value": 6 }] } },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Blocks reconstructed" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "decimals", "value": 0 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Mean reconstruction" },
            "properties": [
              { "id": "unit", "value": "s" }
            ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 15, "x": 0, "y": 8 },
      "id": 25,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "Node" }]
      },
      "targets": [
        { "refId": "A", "expr": "max by (node) (max_over_time(up{job=\"fibre\"}[30s]))", "format": "table", "instant": true, "range": false },
        { "refId": "B", "expr": "scalar(max(fibre_last_block_height)) - max by (node) (fibre_last_block_height)", "format": "table", "instant": true, "range": false },
        { "refId": "C", "expr": "round(sum by (node) (increase(fibre_blocks_reconstructed_total[$__range])))", "format": "table", "instant": true, "range": false },
        { "refId": "D", "expr": "sum by (node) (increase(fibre_block_reconstruction_duration_seconds_sum[$__range])) / (sum by (node) (increase(fibre_block_reconstruction_duration_seconds_count[$__range])) > 0)", "format": "table", "instant": true, "range": false }
      ],
      "title": "Node Status",
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": { "node": 0, "Value #A": 1, "Value #B": 2, "Value #C": 3, "Value #D": 4 },
            "renameByName": { "node": "Node", "Value #A": "Status", "Value #B": "Blocks behind", "Value #C": "Blocks reconstructed", "Value #D": "Mean reconstruction" }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Whether the collector could reach each node's exporter over the selected time range. Green is up; red is down or unreachable for 30 seconds or more. It follows the exporter, so a node can relay blocks while its strip is red.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "fillOpacity": 55,
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineWidth": 0,
            "spanNulls": false
          },
          "mappings": [{ "type": "value", "options": { "0": { "index": 0, "text": "Down" }, "1": { "index": 1, "text": "Up" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 9, "x": 15, "y": 8 },
      "id": 26,
      "options": {
        "alignValue": "left",
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "mergeValues": true,
        "rowHeight": 0.55,
        "showValue": "never",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        { "refId": "A", "expr": "max by (node) (max_over_time(up{job=\"fibre\"}[30s]))", "legendFormat": "{{node}}" }
      ],
      "title": "Availability",
      "type": "state-timeline"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 32,
      "panels": [],
      "title": "Blocks",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Time from the first UDP packet of a block to the block being fully decoded. Each dot is one block on one node; two blocks less than about a minute apart on the same node share a dot at their average. Lower is better. The time includes waiting for chunks to arrive, so it rises when the node's mempool is missing more of the block: compare with Missing Transaction Bytes per Block beside it.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic-by-name" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "barAlignment": 0,
            "drawStyle": "points",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 8,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "always",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 12,
      "interval": "1m",
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "rate(fibre_block_reconstruction_duration_seconds_sum{node=~\".*\"}[$__rate_interval]) / rate(fibre_block_reconstruction_duration_seconds_count{node=~\".*\"}[$__rate_interval])", "legendFormat": "{{node}}" }
      ],
      "title": "Reconstruction Time per Block",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "The transactions of a block that a node did not already have in its mempool and had to receive as FIBRE chunks. Each dot is one block on one node, placed by the serialized bytes that were missing; hover over a dot to also see how many transactions that was. Two blocks less than about a minute apart on the same node share a dot at their average. More missing bytes mean more chunks to wait for, and a longer reconstruction.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic-by-name" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "barAlignment": 0,
            "drawStyle": "points",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 8,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "always",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] },
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } },
              { "id": "custom.axisPlacement", "value": "hidden" },
              { "id": "custom.hideFrom", "value": { "legend": true, "tooltip": false, "viz": false } },
              { "id": "custom.drawStyle", "value": "line" },
              { "id": "custom.lineWidth", "value": 0 },
              { "id": "custom.showPoints", "value": "never" }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 18,
      "interval": "1m",
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        { "refId": "A", "expr": "rate(fibre_block_missing_tx_bytes_sum{node=~\".*\"}[$__rate_interval]) / rate(fibre_block_missing_tx_bytes_count{node=~\".*\"}[$__rate_interval])", "legendFormat": "{{node}}" },
        { "refId": "B", "expr": "rate(fibre_block_missing_tx_count_sum{node=~\".*\"}[$__rate_interval]) / rate(fibre_block_missing_tx_count_count{node=~\".*\"}[$__rate_interval])", "legendFormat": "{{node}} transactions" }
      ],
      "title": "Missing Transactions per Block",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "How many block reconstructions, counted once per node, fell into each time band over the selected time range. The bands follow the exporter's histogram buckets.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "mappings": [],
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "id": 27,
      "options": {
        "displayMode": "basic",
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": false },
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "left",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "text"
      },
      "targets": [
        { "refId": "A", "expr": "round(sum(increase(fibre_block_reconstruction_duration_seconds_bucket{le=\"0.025\"}[$__range])))", "legendFormat": "under 25 ms", "instant": true, "range": false },
        { "refId": "B", "expr": "round(sum(increase(fibre_block_reconstruction_duration_seconds_bucket{le=\"0.05\"}[$__range])) - sum(increase(fibre_block_reconstruction_duration_seconds_bucket{le=\"0.025\"}[$__range])))", "legendFormat": "25 to 50 ms", "instant": true, "range": false },
        { "refId": "C", "expr": "round(sum(increase(fibre_block_reconstruction_duration_seconds_bucket{le=\"0.1\"}[$__range])) - sum(increase(fibre_block_reconstruction_duration_seconds_bucket{le=\"0.05\"}[$__range])))", "legendFormat": "50 to 100 ms", "instant": true, "range": false },
        { "refId": "D", "expr": "round(sum(increase(fibre_block_reconstruction_duration_seconds_bucket{le=\"0.25\"}[$__range])) - sum(increase(fibre_block_reconstruction_duration_seconds_bucket{le=\"0.1\"}[$__range])))", "legendFormat": "100 to 250 ms", "instant": true, "range": false },
        { "refId": "E", "expr": "round(sum(increase(fibre_block_reconstruction_duration_seconds_bucket{le=\"+Inf\"}[$__range])) - sum(increase(fibre_block_reconstruction_duration_seconds_bucket{le=\"0.25\"}[$__range])))", "legendFormat": "over 250 ms", "instant": true, "range": false }
      ],
      "title": "Reconstruction Time Distribution",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Share of the chunks a node received for a block that it did not need. These are mostly chunks it already had, from another peer or filled in from its own mempool, so a node fed by several peers normally shows more of them. Each dot is one block on one node. This is not packet loss: a lost packet never arrives to be counted, and a chunk that replaces it counts as needed.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic-by-name" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "axisSoftMax": 0.1,
            "axisSoftMin": 0,
            "barAlignment": 0,
            "drawStyle": "points",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 8,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "always",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "id": 16,
      "interval": "1m",
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "1 - increase(fibre_chunks_used_total{node=~\".*\"}[$__rate_interval]) / increase(fibre_chunks_received_total{node=~\".*\"}[$__rate_interval])", "legendFormat": "{{node}}" }
      ],
      "title": "Unneeded Chunks per Block",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["fibre", "bitcoin", "block-relay", "public"],
  "templating": {
    "list": []
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "FIBRE Block Relay (Public)",
  "uid": "fibre-relay-public",
  "version": 1
}
