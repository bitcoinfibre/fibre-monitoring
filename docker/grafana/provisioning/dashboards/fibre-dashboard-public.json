{
  "annotations": {
    "list": [
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "expr": "max by (height) (fibre_block_reconstructed_event == 1) unless max by (height) (fibre_block_reconstructed_event offset 15s == 1)",
        "iconColor": "rgba(204, 204, 220, 0.5)",
        "name": "Block Arrival",
        "titleFormat": "Block {{height}}",
        "step": "15s",
        "filter": { "exclude": true, "ids": [26] }
      }
    ]
  },
  "description": "Real-time monitoring of FIBRE block relay performance (public view)",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "options": {
        "content": "FIBRE relays new Bitcoin blocks between nodes over UDP with error correction.<br>This page shows the monitored nodes and how quickly each one rebuilds blocks.",
        "mode": "markdown"
      },
      "transparent": true,
      "type": "text"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 3 },
      "id": 30,
      "panels": [],
      "title": "Network",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "How many monitored nodes the collector can reach. A node counts as down once its exporter has not answered for 30 seconds, so a restart that misses one scrape does not show.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Down" },
            "properties": [
              { "id": "color", "value": { "mode": "thresholds" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "text", "value": null }, { "color": "red", "value": 1 }] } }
            ]
          }
        ]
      },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 4 },
      "id": 20,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        { "refId": "A", "expr": "count(max_over_time(up{job=\"fibre\"}[30s]) == 1) or vector(0)", "legendFormat": "Up", "instant": true, "range": false },
        { "refId": "B", "expr": "count(max_over_time(up{job=\"fibre\"}[30s]) == 0) or vector(0)", "legendFormat": "Down", "instant": true, "range": false }
      ],
      "title": "Nodes",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "The highest block height any node has seen.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 4 },
      "id": 21,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        { "refId": "A", "expr": "max(fibre_last_block_height)", "instant": true, "range": false }
      ],
      "title": "Chain Tip",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "How long ago the chain tip last advanced on any node, by any delivery path. Blocks arrive about every 10 minutes on average, but an hour without one happens a few times a year. Looks back 6 hours.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "mappings": [],
          "noValue": "over 6 h",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }, { "color": "orange", "value": 3600 }, { "color": "red", "value": 7200 }] },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 4 },
      "id": 22,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        { "refId": "A", "expr": "time() - max_over_time((vector(time()) and on() (max(fibre_last_block_height) > max(fibre_last_block_height offset 30s)))[6h:15s])", "instant": true, "range": false }
      ],
      "title": "Time Since Last Block",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 31,
      "panels": [],
      "title": "Nodes",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "One row per monitored node. Status is whether the collector has reached the node's exporter in the last 30 seconds. Behind is how many blocks the node's last seen height trails the chain tip. The other columns cover the selected time range. Rebuilt counts the blocks the node assembled from FIBRE/UDP chunks. Win rate is, of the blocks FIBRE/UDP and compact blocks raced to deliver to the node, the share FIBRE/UDP delivered; a block the node heard first over TCP, before any FIBRE peer had it, is not a race, and a node with no races shows a dash. Mean time is the node's mean time from the first UDP packet to the decoded block. A node that is down shows no figures.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": false,
            "inspect": false,
            "minWidth": 64
          },
          "mappings": [],
          "noValue": "–",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              { "id": "mappings", "value": [{ "type": "value", "options": { "0": { "color": "red", "index": 0, "text": "● Down" }, "1": { "color": "green", "index": 1, "text": "● Up" } } }] },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "custom.align", "value": "left" },
              { "id": "custom.width", "value": 84 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Behind" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "color", "value": { "mode": "thresholds" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "text", "value": null }, { "color": "orange", "value": 2 }, { "color": "red", "value": 6 }] } },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Rebuilt" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "decimals", "value": 0 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Win rate" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.minWidth", "value": 72 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Mean time" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "custom.minWidth", "value": 84 }
            ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 15, "x": 0, "y": 9 },
      "id": 25,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "Node" }]
      },
      "targets": [
        { "refId": "A", "expr": "max by (node) (max_over_time(up{job=\"fibre\"}[30s]))", "format": "table", "instant": true, "range": false },
        { "refId": "B", "expr": "scalar(max(fibre_last_block_height)) - max by (node) (fibre_last_block_height)", "format": "table", "instant": true, "range": false },
        { "refId": "C", "expr": "round(sum by (node) (increase(fibre_blocks_reconstructed_total[$__range])))", "format": "table", "instant": true, "range": false },
        { "refId": "D", "expr": "sum by (node) (increase(fibre_block_reconstruction_duration_seconds_sum[$__range])) / (sum by (node) (increase(fibre_block_reconstruction_duration_seconds_count[$__range])) > 0)", "format": "table", "instant": true, "range": false },
        { "refId": "E", "expr": "sum by (node) (increase(fibre_block_races_total{outcome=\"fibre_won\"}[$__range])) / (sum by (node) (increase(fibre_block_races_total{outcome=~\"fibre_won|fibre_lost\"}[$__range])) > 0)", "format": "table", "instant": true, "range": false }
      ],
      "title": "Node Status",
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": { "node": 0, "Value #A": 1, "Value #B": 2, "Value #C": 3, "Value #E": 4, "Value #D": 5 },
            "renameByName": { "node": "Node", "Value #A": "Status", "Value #B": "Behind", "Value #C": "Rebuilt", "Value #E": "Win rate", "Value #D": "Mean time" }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Whether the collector could reach each node's exporter over the selected time range. A faint green bar is up; a solid red bar is down or unreachable for 30 seconds or more. It follows the exporter, so a node can relay blocks while its strip is red.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "custom": {
            "fillOpacity": 100,
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineWidth": 0,
            "spanNulls": false
          },
          "mappings": [{ "type": "value", "options": { "0": { "color": "red", "index": 0, "text": "Down" }, "1": { "color": "#56A64B66", "index": 1, "text": "Up" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 9, "x": 15, "y": 9 },
      "id": 26,
      "options": {
        "alignValue": "left",
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "mergeValues": true,
        "rowHeight": 0.55,
        "showValue": "never",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        { "refId": "A", "expr": "max by (node) (max_over_time(up{job=\"fibre\"}[30s]))", "legendFormat": "{{node}}" }
      ],
      "title": "Availability",
      "type": "state-timeline"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 32,
      "panels": [],
      "title": "Blocks",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Time from the first UDP packet of a block to the block being fully decoded. Each dot is one block on one node; two blocks less than about a minute apart on the same node share a dot at their average. Lower is better. The time includes waiting for chunks to arrive, so it rises when the node's mempool is missing more of the block: compare with Missing Transaction Bytes per Block beside it.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "barAlignment": 0,
            "drawStyle": "points",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 8,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "always",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": { "id": "byValue", "options": { "reducer": "allIsNull" } },
            "properties": [
              { "id": "custom.hideFrom", "value": { "legend": true, "tooltip": true, "viz": true } }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 12,
      "interval": "1m",
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "sum by (node) (rate(fibre_block_reconstruction_duration_seconds_sum[$__rate_interval])) / sum by (node) (rate(fibre_block_reconstruction_duration_seconds_count[$__rate_interval])) or on (node) (max by (node) (up{job=\"fibre\"}) * NaN)", "legendFormat": "{{node}}" }
      ],
      "title": "Reconstruction Time per Block",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "The transactions of a block that a node did not already have in its mempool and had to receive as FIBRE chunks. Each dot is one block on one node, placed by the serialized bytes that were missing; hover over a dot to also see how many transactions that was. Two blocks less than about a minute apart on the same node share a dot at their average. More missing bytes mean more chunks to wait for, and a longer reconstruction.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "barAlignment": 0,
            "drawStyle": "points",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 8,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "always",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] },
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } },
              { "id": "custom.axisPlacement", "value": "hidden" },
              { "id": "custom.hideFrom", "value": { "legend": true, "tooltip": false, "viz": false } },
              { "id": "custom.drawStyle", "value": "line" },
              { "id": "custom.lineWidth", "value": 0 },
              { "id": "custom.showPoints", "value": "never" }
            ]
          },
          {
            "matcher": { "id": "byValue", "options": { "reducer": "allIsNull" } },
            "properties": [
              { "id": "custom.hideFrom", "value": { "legend": true, "tooltip": true, "viz": true } }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 18,
      "interval": "1m",
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        { "refId": "A", "expr": "sum by (node) (rate(fibre_block_missing_tx_bytes_sum[$__rate_interval])) / sum by (node) (rate(fibre_block_missing_tx_bytes_count[$__rate_interval])) or on (node) (max by (node) (up{job=\"fibre\"}) * NaN)", "legendFormat": "{{node}}" },
        { "refId": "B", "expr": "rate(fibre_block_missing_tx_count_sum{node=~\".*\"}[$__rate_interval]) / rate(fibre_block_missing_tx_count_count{node=~\".*\"}[$__rate_interval])", "legendFormat": "{{node}} transactions" }
      ],
      "title": "Missing Transactions per Block",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "How many block reconstructions, counted once per node, fell into each time band over the selected time range. The bars count the records listed in Recent Blocks beside it, so filtering that list by Band shows exactly the blocks behind a bar.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "mappings": [],
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 7, "x": 0, "y": 27 },
      "id": 27,
      "options": {
        "displayMode": "basic",
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": false },
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "left",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "text"
      },
      "targets": [
        { "refId": "A", "expr": "count(max by (node, height) (last_over_time(fibre_recent_block_reconstruction_seconds[$__range])) < 0.025) or vector(0)", "legendFormat": "under 25 ms", "instant": true, "range": false },
        { "refId": "B", "expr": "count(max by (node, height) (last_over_time(fibre_recent_block_reconstruction_seconds[$__range])) >= 0.025 < 0.05) or vector(0)", "legendFormat": "25 to 50 ms", "instant": true, "range": false },
        { "refId": "C", "expr": "count(max by (node, height) (last_over_time(fibre_recent_block_reconstruction_seconds[$__range])) >= 0.05 < 0.1) or vector(0)", "legendFormat": "50 to 100 ms", "instant": true, "range": false },
        { "refId": "D", "expr": "count(max by (node, height) (last_over_time(fibre_recent_block_reconstruction_seconds[$__range])) >= 0.1 < 0.25) or vector(0)", "legendFormat": "100 to 250 ms", "instant": true, "range": false },
        { "refId": "E", "expr": "count(max by (node, height) (last_over_time(fibre_recent_block_reconstruction_seconds[$__range])) >= 0.25) or vector(0)", "legendFormat": "over 250 ms", "instant": true, "range": false }
      ],
      "title": "Reconstruction Time Distribution",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Share of the chunks a node received for a block that it did not need. These are mostly chunks it already had, from another peer or filled in from its own mempool, so a node fed by several peers normally shows more of them. Each dot is one block on one node. This is not packet loss: a lost packet never arrives to be counted, and a chunk that replaces it counts as needed.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "axisSoftMax": 0.1,
            "axisSoftMin": 0,
            "barAlignment": 0,
            "drawStyle": "points",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 8,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "always",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] },
          "unit": "percentunit"
        },
        "overrides": [
          {
            "matcher": { "id": "byValue", "options": { "reducer": "allIsNull" } },
            "properties": [
              { "id": "custom.hideFrom", "value": { "legend": true, "tooltip": true, "viz": true } }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 27 },
      "id": 16,
      "interval": "1m",
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "1 - sum by (node) (increase(fibre_chunks_used_total[$__rate_interval])) / sum by (node) (increase(fibre_chunks_received_total[$__rate_interval])) or on (node) (max by (node) (up{job=\"fibre\"}) * NaN)", "legendFormat": "{{node}}" }
      ],
      "title": "Unneeded Chunks per Block",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Every block reconstructed in the selected time range, newest first: which node reconstructed it, the exact time it took, and the time band that puts it in. To list the blocks behind one bar of Reconstruction Time Distribution, use the filter icon in the Band column's header; it narrows this list only. A block appears once for each node that reconstructed it over FIBRE.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": false,
            "inspect": false
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Block" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "custom.align", "value": "left" },
              { "id": "custom.width", "value": 95 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Node" },
            "properties": [
              { "id": "custom.width", "value": 110 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "custom.width", "value": 100 }
            ]
          },
          {
