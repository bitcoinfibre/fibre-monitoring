{
  "annotations": {
    "list": []
  },
  "description": "Real-time monitoring of FIBRE block relay performance",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "text", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Mechanism" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "mappings", "value": [
                { "options": { "fibre_udp": { "color": "green", "index": 0, "text": "FIBRE/UDP" } }, "type": "value" },
                { "options": { "bip152_cmpct": { "color": "orange", "index": 1, "text": "Compact" } }, "type": "value" }
              ]}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "displayName", "value": "Deliveries" },
              { "id": "decimals", "value": 0 }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 21,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Deliveries" }]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (peer, mechanism) (increase(fibre_block_deliveries_total{node=~\"$node\"}[$__range])) > 0",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Block Delivery by Peer",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "peer": 0,
              "mechanism": 1,
              "Value": 2
            },
            "renameByName": {
              "peer": "Peer",
              "mechanism": "Mechanism",
              "Value": "Deliveries"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Of the blocks FIBRE/UDP and compact blocks raced for in the selected time range, the share FIBRE/UDP delivered. Blocks counted as no race, such as one the node heard first over TCP before any FIBRE peer had it, are left out: see fibre_block_races_total in METRICS.md.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          },
          "unit": "percentunit",
          "decimals": 1
        }
      },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 0 },
      "id": 22,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (increase(fibre_block_races_total{node=~\"$node\",outcome=\"fibre_won\"}[$__range])) / (sum by (node) (increase(fibre_block_races_total{node=~\"$node\",outcome=~\"fibre_won|fibre_lost\"}[$__range])) > 0)",
          "legendFormat": "{{node}}"
        }
      ],
      "title": "FIBRE Relay Win Rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Mean time from the first UDP packet of a block to the block being fully decoded, over every block the node reconstructed in the selected time range. Lower is better. The time includes waiting for chunks to arrive, so it rises when the node's mempool is missing more of the block.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 4 },
      "id": 23,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (increase(fibre_block_reconstruction_duration_seconds_sum{node=~\"$node\"}[$__range])) / (sum by (node) (increase(fibre_block_reconstruction_duration_seconds_count{node=~\"$node\"}[$__range])) > 0)",
          "legendFormat": "{{node}}",
          "instant": true,
          "range": false
        }
      ],
      "title": "Mean Reconstruction Time",
      "type": "stat"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["fibre", "bitcoin", "block-relay"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(up{job=\"fibre\"}, node)",
        "hide": 0,
        "includeAll": true,
        "label": "Node",
        "multi": true,
        "name": "node",
        "options": [],
        "query": { "query": "label_values(up{job=\"fibre\"}, node)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "FIBRE Block Relay",
  "uid": "fibre-relay",
  "version": 1
}
